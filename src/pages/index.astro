---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- STICKY NAV -->
  <nav id="main-nav">
    <div class="nav-inner">
      <a href="#hero" class="nav-logo">
        <span class="gradient-text">Armonic</span>&nbsp;Themes
      </a>
      <div class="nav-links" id="nav-links">
        <a href="#hero" class="nav-link active" data-section="hero">Inicio</a>
        <a href="#generator" class="nav-link" data-section="generator">Generador</a>
        <a href="#export-section" class="nav-link" data-section="export-section">Exportar</a>
        <a href="#saved-section" class="nav-link" data-section="saved-section">Guardados</a>
      </div>
      <div class="nav-actions">
        <button id="app-theme-toggle" class="theme-toggle-btn" title="Cambiar tema del sitio">
          <span id="theme-icon">☀</span>
        </button>
        <button id="mobile-menu-btn" class="mobile-menu-btn">☰</button>
      </div>
    </div>
  </nav>

  <!-- HERO / LANDING -->
  <section id="hero" class="section-hero">
    <div class="hero-glow hero-glow-1"></div>
    <div class="hero-glow hero-glow-2"></div>
    <div class="hero-glow hero-glow-3"></div>

    <div class="hero-content animate-fade-in-up">
      <p class="hero-eyebrow">Generador de paletas semánticas</p>
      <h1 class="hero-title">
        Temas de color<br/><span class="gradient-text">armónicos y accesibles</span>
      </h1>
      <p class="hero-desc">
        Crea paletas con 14 variables semánticas, modo claro y oscuro incluido. Exporta a Tailwind v4, CSS puro o Tailwind v3 en un clic.
      </p>
      <div class="hero-ctas">
        <button id="hero-generate-btn" class="btn btn-primary btn-lg">
          ✦ Generar Tema Ahora
        </button>
        <a href="#generator" class="btn btn-ghost btn-lg">Explorar ↓</a>
      </div>
    </div>

    <!-- Animated color orbs -->
    <div class="hero-orbs" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
      <div class="orb orb-4"></div>
      <div class="orb orb-5"></div>
    </div>
  </section>

  <!-- GENERATOR SECTION -->
  <section id="generator" class="section-padded">
    <div class="section-header">
      <h2 class="section-heading">Generador de Temas</h2>
      <p class="section-subheading">Presiona generar y obtén una paleta completa con armonía de color garantizada</p>
    </div>

    <div id="gen-grid" class="gen-grid">
      <!-- LEFT: Controls -->
      <div class="gen-controls">
        <div class="panel">
          <button id="generate-btn" class="btn btn-primary" style="width:100%;font-size:1rem;padding:0.9rem;">
            ✦ Generar Nuevo Tema
          </button>
          <p id="theme-count-label" class="gen-counter">0 temas generados esta sesión</p>

          <div class="gen-active-card">
            <p class="section-title">Tema Activo</p>
            <p id="current-theme-name" class="gen-active-name">—</p>
            <div class="gen-badges" id="gen-badges"></div>
          </div>

          <div id="current-swatches" class="swatch-row" style="height:36px;border-radius:var(--radius-md);overflow:hidden;margin-top:0.75rem;"></div>

          <button id="save-btn" class="btn btn-ghost" style="width:100%;margin-top:0.75rem;" disabled>
            ★ Guardar en Favoritos
          </button>
        </div>

        <!-- Preview Mode Toggle -->
        <div class="panel">
          <p class="section-title" style="margin-bottom:0.75rem;">Modo de Vista Previa</p>
          <div class="tabs">
            <button class="tab active" id="tab-light" data-mode="light">☀ Light</button>
            <button class="tab" id="tab-dark" data-mode="dark">☾ Dark</button>
          </div>
        </div>

        <!-- History -->
        <div class="panel">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
            <p class="section-title">Historial</p>
            <button id="clear-history-btn" class="btn btn-ghost" style="font-size:0.7rem;padding:0.2rem 0.5rem;" disabled>Limpiar</button>
          </div>
          <div id="history-list" class="history-list">
            <p id="history-empty" class="empty-msg">Genera tu primer tema para empezar</p>
          </div>
        </div>
      </div>

      <!-- RIGHT: Preview -->
      <div class="gen-preview">
        <div class="panel" style="padding:0;overflow:hidden;">
          <div class="preview-root" id="preview-root">

            <!-- Navbar -->
            <nav class="pv-nav">
              <span class="pv-logo">MyApp</span>
              <div class="pv-nav-links"><span>Inicio</span><span>Acerca</span><span>Precios</span></div>
              <button class="pv-btn-primary" style="padding:0.3rem 0.85rem;font-size:0.8rem;">Login</button>
            </nav>

            <!-- Hero -->
            <div class="pv-hero">
              <p class="pv-eyebrow">Bienvenido</p>
              <h2 class="pv-title">Construye algo increíble hoy</h2>
              <p class="pv-desc">Una descripción que convence. Esta paleta hace que todo luzca coherente y profesional.</p>
              <div class="pv-ctas">
                <button class="pv-btn-primary">Empezar Gratis</button>
                <button class="pv-btn-secondary">Ver Demo</button>
              </div>
            </div>

            <!-- Cards -->
            <div class="pv-cards">
              <div class="pv-card">
                <div class="pv-icon">✦</div>
                <p class="pv-card-title">Diseño</p>
                <p class="pv-card-desc">Hermoso y consistente en toda la interfaz.</p>
              </div>
              <div class="pv-card">
                <div class="pv-icon">◈</div>
                <p class="pv-card-title">Accesible</p>
                <p class="pv-card-desc">Contraste garantizado en cada combinación.</p>
              </div>
              <div class="pv-card">
                <div class="pv-icon">⚡</div>
                <p class="pv-card-title">Escalable</p>
                <p class="pv-card-desc">Variables semánticas listas para producción.</p>
              </div>
            </div>

            <!-- Form + Alerts -->
            <div class="pv-bottom-row">
              <div class="pv-form-card">
                <label class="pv-label">Email</label>
                <div class="pv-input">usuario@email.com</div>
                <button class="pv-btn-primary" style="width:100%;">Suscribirse</button>
              </div>
              <div class="pv-alerts">
                <div class="pv-alert pv-alert-accent">✓ Operación completada con éxito.</div>
                <div class="pv-alert pv-alert-destructive">✕ Algo salió mal. Intenta de nuevo.</div>
                <div class="pv-alert pv-alert-muted">ℹ Información secundaria aquí.</div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EXPORT SECTION -->
  <section id="export-section" class="section-padded">
    <div class="section-header">
      <h2 class="section-heading">Exportar Código</h2>
      <p class="section-subheading">Copia el código listo para pegar en tu proyecto</p>
    </div>

    <div class="export-grid">
      <div class="panel export-panel">
        <div class="tabs" style="margin-bottom:1rem;">
          <button class="tab active" data-export="tw4">Tailwind v4</button>
          <button class="tab" data-export="css">CSS Variables</button>
          <button class="tab" data-export="tw3">Tailwind v3</button>
        </div>
        <div style="position:relative;">
          <pre class="code-block" id="export-code"><code id="export-content" style="white-space:pre-wrap;">Genera un tema para ver el código...</code></pre>
          <button class="copy-btn" id="copy-btn">Copiar</button>
        </div>
      </div>

      <div class="panel">
        <p class="section-title" style="margin-bottom:0.75rem;">Tabla de Colores</p>
        <div id="color-table" class="color-table">
          <p class="empty-msg">Genera un tema para ver los colores</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SAVED SECTION -->
  <section id="saved-section" class="section-padded">
    <div class="section-header">
      <h2 class="section-heading">Temas Guardados</h2>
      <p class="section-subheading">Tus paletas favoritas guardadas en el navegador</p>
    </div>

    <div class="warning-banner" style="max-width:680px;margin:0 auto 2rem;">
      <span style="font-size:1.2rem;flex-shrink:0;">⚠</span>
      <span><strong>Almacenamiento temporal.</strong> Los favoritos se guardan en tu navegador y se perderán si limpias el historial. Usa la exportación para conservarlos.</span>
    </div>

    <div class="panel" style="max-width:680px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
        <p class="section-title">★ Mis Favoritos</p>
        <button id="clear-favs-btn" class="btn btn-danger" style="font-size:0.7rem;padding:0.25rem 0.6rem;" disabled>Limpiar todo</button>
      </div>
      <div id="favorites-list" class="favorites-grid">
        <p id="favs-empty" class="empty-msg" style="grid-column:1/-1;">No hay favoritos guardados aún</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer">
    <p>Hecho con ♥ por <strong class="gradient-text">devcito</strong></p>
    <p style="margin-top:0.4rem;opacity:0.5;">Colores generados con armonía HSL y contraste WCAG</p>
  </footer>
</Layout>

<script type="module">
  import { generateTheme, exportTailwindV4, exportCSSVariables, exportTailwindV3 } from '/src/scripts/color-algorithm.js';
  import { addToHistory, getHistory, clearHistory, saveFavorite, getFavorites, deleteFavorite, clearAllFavorites, isFavorite } from '/src/scripts/theme-store.js';

  // ── State ──────────────────────────────────────────────────────────────────
  let currentTheme = null;
  let currentMode = 'light';
  let currentExport = 'tw4';
  let sessionCount = 0;
  let appDark = true; // App starts in dark mode

  // ── DOM refs ───────────────────────────────────────────────────────────────
  const previewRoot       = document.getElementById('preview-root');
  const currentSwatches   = document.getElementById('current-swatches');
  const currentThemeName  = document.getElementById('current-theme-name');
  const genBadges         = document.getElementById('gen-badges');
  const themeCountLabel   = document.getElementById('theme-count-label');
  const exportContent     = document.getElementById('export-content');
  const copyBtn           = document.getElementById('copy-btn');
  const saveBtn           = document.getElementById('save-btn');
  const historyList       = document.getElementById('history-list');
  const historyEmpty      = document.getElementById('history-empty');
  const clearHistoryBtn   = document.getElementById('clear-history-btn');
  const favoritesList     = document.getElementById('favorites-list');
  const favsEmpty         = document.getElementById('favs-empty');
  const clearFavsBtn      = document.getElementById('clear-favs-btn');
  const colorTable        = document.getElementById('color-table');

  // ── App theme toggle (light/dark for the whole site) ──────────────────────
  const themeToggle = document.getElementById('app-theme-toggle');
  const themeIcon = document.getElementById('theme-icon');

  function setAppTheme(dark) {
    appDark = dark;
    document.documentElement.setAttribute('data-app-theme', dark ? 'dark' : 'light');
    themeIcon.textContent = dark ? '☀' : '☾';
  }

  themeToggle.addEventListener('click', () => setAppTheme(!appDark));
  setAppTheme(true); // Default dark

  // ── Mobile nav toggle ────────────────────────────────────────────────────
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const navLinks = document.getElementById('nav-links');
  mobileMenuBtn.addEventListener('click', () => {
    navLinks.classList.toggle('open');
    mobileMenuBtn.textContent = navLinks.classList.contains('open') ? '✕' : '☰';
  });
  // Close menu on link click
  navLinks.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      navLinks.classList.remove('open');
      mobileMenuBtn.textContent = '☰';
    });
  });

  // ── Active nav highlight on scroll ────────────────────────────────────────
  const sections = document.querySelectorAll('section[id]');
  const navLinkEls = document.querySelectorAll('.nav-link[data-section]');
  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(s => {
      if (window.scrollY >= s.offsetTop - 120) current = s.id;
    });
    navLinkEls.forEach(el => {
      el.classList.toggle('active', el.dataset.section === current);
    });
  });

  // ── Apply theme to preview ─────────────────────────────────────────────────
  function applyThemeToPreview(theme, mode) {
    const colors = theme[mode];
    Object.entries(colors).forEach(([key, val]) => {
      previewRoot.style.setProperty(`--${key}`, val);
    });
  }

  function updateExportCode() {
    if (!currentTheme) return;
    let code = '';
    if (currentExport === 'tw4') code = exportTailwindV4(currentTheme);
    else if (currentExport === 'css') code = exportCSSVariables(currentTheme);
    else code = exportTailwindV3(currentTheme);
    exportContent.textContent = code;
  }

  function updateColorTable(theme) {
    const colors = theme[currentMode];
    colorTable.innerHTML = Object.entries(colors).map(([key, val]) => `
      <div class="color-row">
        <div class="color-swatch" style="background:${val};"></div>
        <div class="color-info">
          <p class="color-name">${key}</p>
          <p class="color-hex">${val}</p>
        </div>
      </div>
    `).join('');
  }

  function renderSwatches(swatches, container) {
    container.innerHTML = swatches.map(c =>
      `<div class="swatch" style="background:${c};"></div>`
    ).join('');
  }

  function createThemeCard(theme, isActive = false) {
    const div = document.createElement('div');
    div.className = `theme-card animate-card-in${isActive ? ' active' : ''}`;
    div.dataset.themeId = theme.id;
    div.innerHTML = `
      <div class="swatch-row" style="height:20px;">
        ${theme.swatches.map(c => `<div class="swatch" style="background:${c};"></div>`).join('')}
      </div>
      <p class="theme-card-name">${theme.name}</p>
    `;
    div.addEventListener('click', () => loadTheme(theme));
    return div;
  }

  function createFavCard(theme) {
    const div = document.createElement('div');
    div.className = 'theme-card animate-card-in';
    div.dataset.themeId = theme.id;
    div.innerHTML = `
      <div class="swatch-row" style="height:20px;">
        ${theme.swatches.map(c => `<div class="swatch" style="background:${c};"></div>`).join('')}
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:0.4rem;">
        <p class="theme-card-name">${theme.name}</p>
        <button data-delete-id="${theme.id}" class="fav-delete-btn">✕</button>
      </div>
    `;
    div.querySelector('[data-delete-id]').addEventListener('click', (e) => {
      e.stopPropagation();
      deleteFavorite(theme.id);
      renderFavorites();
    });
    div.addEventListener('click', () => loadTheme(theme));
    return div;
  }

  function loadTheme(theme) {
    currentTheme = theme;
    currentThemeName.textContent = theme.name;
    genBadges.innerHTML = `
      <span class="badge badge-accent">${theme.harmony || ''}</span>
      <span class="badge badge-accent">${theme.mood || ''}</span>
    `;
    renderSwatches(theme.swatches, currentSwatches);
    applyThemeToPreview(theme, currentMode);
    updateColorTable(theme);
    updateExportCode();
    saveBtn.disabled = false;
    document.querySelectorAll('.theme-card').forEach(c => {
      c.classList.toggle('active', c.dataset.themeId === theme.id);
    });
    saveBtn.textContent = isFavorite(theme.id) ? '★ Guardado' : '★ Guardar en Favoritos';
  }

  function renderHistory() {
    const items = getHistory();
    historyEmpty.style.display = items.length ? 'none' : 'block';
    clearHistoryBtn.disabled = items.length === 0;
    historyList.querySelectorAll('.theme-card').forEach(el => el.remove());
    items.forEach((t, i) => {
      const card = createThemeCard(t, currentTheme?.id === t.id);
      card.style.animationDelay = `${i * 30}ms`;
      historyList.appendChild(card);
    });
  }

  function renderFavorites() {
    const items = getFavorites();
    favsEmpty.style.display = items.length ? 'none' : 'block';
    clearFavsBtn.disabled = items.length === 0;
    favoritesList.querySelectorAll('.theme-card').forEach(el => el.remove());
    items.forEach(t => favoritesList.appendChild(createFavCard(t)));
  }

  function doGenerate() {
    const theme = generateTheme();
    addToHistory(theme);
    sessionCount++;
    themeCountLabel.textContent = `${sessionCount} tema${sessionCount !== 1 ? 's' : ''} generado${sessionCount !== 1 ? 's' : ''} esta sesión`;
    loadTheme(theme);
    renderHistory();
  }

  // ── Event listeners ────────────────────────────────────────────────────────
  document.getElementById('generate-btn').addEventListener('click', doGenerate);
  document.getElementById('hero-generate-btn').addEventListener('click', () => {
    doGenerate();
    document.getElementById('generator').scrollIntoView({ behavior: 'smooth' });
  });

  saveBtn.addEventListener('click', () => {
    if (!currentTheme) return;
    const saved = saveFavorite(currentTheme);
    saveBtn.textContent = saved ? '★ Guardado' : '★ Ya en Favoritos';
    if (saved) renderFavorites();
  });

  clearHistoryBtn.addEventListener('click', () => { clearHistory(); renderHistory(); });

  clearFavsBtn.addEventListener('click', () => {
    if (confirm('¿Borrar todos los temas guardados? Esta acción no se puede deshacer.')) {
      clearAllFavorites();
      renderFavorites();
    }
  });

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(exportContent.textContent).then(() => {
      copyBtn.textContent = '✓ Copiado';
      copyBtn.classList.add('copied');
      setTimeout(() => { copyBtn.textContent = 'Copiar'; copyBtn.classList.remove('copied'); }, 2000);
    });
  });

  document.querySelectorAll('[data-mode]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-mode]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentMode = btn.dataset.mode;
      if (currentTheme) { applyThemeToPreview(currentTheme, currentMode); updateColorTable(currentTheme); }
    });
  });

  document.querySelectorAll('[data-export]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-export]').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentExport = btn.dataset.export;
      updateExportCode();
    });
  });

  // ── Init ───────────────────────────────────────────────────────────────────
  renderFavorites();
  doGenerate();
</script>
