---
import Layout from "../../layouts/Layout.astro";

const title = "Blog — Armonic Themes";
const description = "Artículos técnicos sobre algoritmos de color, teoría del diseño, accesibilidad y generación de paletas.";

const posts = [
  {
    title: "Cómo funciona el algoritmo de colores de Armonic Themes",
    description: "Una mirada técnica a cómo generar paletas que siempre se ven bien, en modo claro y oscuro. Armonía de color, WCAG automático y modo oscuro con personalidad.",
    href: "/blog/como-funciona-el-algoritmo-de-colores",
    tags: ["Algoritmos", "Diseño", "WCAG"],
    date: "Mayo 2026",
    readtime: "8 min",
  },
];
---

<Layout title={title} description={description}>
  <div class="bg-grid"></div>

  <nav id="main-nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <span class="gradient-text">Armonic</span>&nbsp;Themes
      </a>
      <div class="nav-links">
        <a href="/" class="nav-link">Inicio</a>
        <a href="/#generator" class="nav-link">Generador</a>
        <a href="/blog" class="nav-link active">Blog</a>
      </div>
      <div class="nav-actions">
        <button id="app-theme-toggle" class="theme-toggle-btn" title="Cambiar tema del sitio">
          <span id="theme-icon">☀</span>
        </button>
      </div>
    </div>
  </nav>

  <main class="blog-main">
    <header class="blog-hero animate-fade-in-up">
      <p class="blog-eyebrow">Artículos</p>
      <h1 class="blog-title">Blog de <span class="gradient-text">Armonic Themes</span></h1>
      <p class="blog-subtitle">Algoritmos de color, teoría del diseño y accesibilidad explicados sin rodeos.</p>
    </header>

    <section class="blog-posts animate-fade-in-up" style="animation-delay: 0.15s">
      {posts.map((post) => (
        <a href={post.href} class="post-card">
          <div class="post-card-meta">
            <span class="post-card-date">{post.date}</span>
            <span class="post-card-dot">·</span>
            <span class="post-card-time">{post.readtime} de lectura</span>
          </div>
          <h2 class="post-card-title">{post.title}</h2>
          <p class="post-card-desc">{post.description}</p>
          <div class="post-card-tags">
            {post.tags.map((tag) => (
              <span class="post-card-tag">{tag}</span>
            ))}
          </div>
          <span class="post-card-cta">Leer artículo →</span>
        </a>
      ))}
    </section>
  </main>

  <script>
    const html = document.documentElement;
    const toggleBtn = document.getElementById('app-theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    function applyTheme(theme: string) {
      html.setAttribute('data-app-theme', theme);
      if (themeIcon) themeIcon.textContent = theme === 'light' ? '☽' : '☀';
      localStorage.setItem('app-theme', theme);
    }
    applyTheme(localStorage.getItem('app-theme') || 'dark');
    toggleBtn?.addEventListener('click', () => {
      applyTheme(html.getAttribute('data-app-theme') === 'dark' ? 'light' : 'dark');
    });
  </script>
</Layout>

<style>
  .blog-main {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 1.25rem 5rem;
  }

  .blog-hero {
    padding: 7rem 0 3rem;
    border-bottom: 1px solid var(--app-border);
    margin-bottom: 3rem;
  }

  .blog-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--app-accent);
    margin-bottom: 1rem;
  }

  .blog-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: 1rem;
    color: var(--app-text);
  }

  .blog-subtitle {
    font-size: 1.125rem;
    color: var(--app-muted);
    line-height: 1.65;
  }

  .blog-posts {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    background: var(--app-surface);
    border: 1px solid var(--app-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .post-card:hover {
    border-color: color-mix(in srgb, var(--app-accent) 40%, transparent);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.3);
  }

  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--app-muted);
  }

  .post-card-dot { opacity: 0.4; }

  .post-card-title {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--app-text);
    line-height: 1.3;
  }

  .post-card:hover .post-card-title {
    color: var(--app-accent);
  }

  .post-card-desc {
    font-size: 0.9375rem;
    color: color-mix(in srgb, var(--app-text) 65%, transparent);
    line-height: 1.7;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .post-card-tag {
    background: color-mix(in srgb, var(--app-accent) 10%, transparent);
    color: var(--app-accent);
    border: 1px solid color-mix(in srgb, var(--app-accent) 25%, transparent);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .post-card-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--app-accent);
    margin-top: 0.5rem;
    transition: gap 0.2s;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--app-accent), var(--app-accent-2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
