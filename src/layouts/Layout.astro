---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Armonic Themes | Generador de Paletas de Colores UI/UX",
  description = "Genera paletas de colores semánticas, accesibles (WCAG) y modernas. Exporta código listo para Tailwind CSS v4, v3 y Variables CSS. Diseñado para desarrolladores y diseñadores.",
  image = "/og-image.svg",
} = Astro.props;

const siteURL = "https://themes.devcito.org";
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteURL).href;
const ogImage = new URL(image, siteURL).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Armonic Themes",
  "url": siteURL,
  "description": description,
  "applicationCategory": "DesignApplication",
  "operatingSystem": "All",
  "inLanguage": "es",
  "isAccessibleForFree": true,
  "creator": {
    "@type": "Person",
    "name": "Devcito",
    "url": "https://devcito.org"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Generador de paletas de colores con armonía garantizada",
    "14 colores semánticos por tema",
    "Modo claro y oscuro",
    "Exportar en Tailwind CSS v4, v3 y Variables CSS",
    "Verificación de contraste WCAG"
  ]
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />

    <!-- Preconnect para performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon e iconos -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#00f2fe" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#0096c7" media="(prefers-color-scheme: light)" />

    <meta name="generator" content={Astro.generator} />

    <!-- SEO Básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="generador de paletas, colores UI, Tailwind CSS, variables CSS, diseño web, paleta de colores, accesibilidad, WCAG, frontend, design system, color palette generator" />
    <meta name="author" content="Devcito" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Armonic Themes" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Armonic Themes — Generador de paletas de colores UI/UX" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@devcito" />
    <meta name="twitter:creator" content="@devcito" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Armonic Themes — Generador de paletas de colores UI/UX" />

    <!-- Datos Estructurados JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
